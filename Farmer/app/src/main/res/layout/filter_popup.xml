<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена"
            android:textStyle="bold"
            android:textColor="#1A2421"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etMinPrice"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_counter_round"
                android:hint="От"
                android:inputType="numberDecimal"
                android:paddingHorizontal="8dp"
                android:textSize="14sp" />

            <View android:layout_width="8dp" android:layout_height="1dp"/>

            <EditText
                android:id="@+id/etMaxPrice"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_counter_round"
                android:hint="До"
                android:inputType="numberDecimal"
                android:paddingHorizontal="8dp"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Категория"
            android:textStyle="bold"
            android:textColor="#1A2421"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_counter_round"
            android:layout_marginTop="8dp">
            <Spinner
                android:popupBackground="@drawable/bg_counter_round"
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сброс"
                android:background="@drawable/bg_status_cancelled"
                android:textColor="#FF5252" />

            <Button
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:backgroundTint="#2D5A27"
                android:text="Применить" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>