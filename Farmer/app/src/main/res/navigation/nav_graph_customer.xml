<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_customer"
    app:startDestination="@id/catalog">

    <fragment
        android:id="@+id/catalog"
        android:name="com.example.farmer.customer.ui.productsboard.ProductsFragment"
        android:label="fragment_products"
        tools:layout="@layout/fragment_products" >
        <action
            android:id="@+id/action_productsFragment_to_profileCustomerFragment"
            app:destination="@id/profile" />
    </fragment>
    <fragment
        android:id="@+id/profile"
        android:name="com.example.farmer.customer.ui.profile.ProfileCustomerFragment"
        android:label="fragment_profile_customer"
        tools:layout="@layout/fragment_profile_customer" >
        <action
            android:id="@+id/action_profileCustomerFragment_to_productsFragment"
            app:destination="@id/catalog" />
    </fragment>
</navigation>